# The client holds no credentials: sign-in runs entirely on the Express server
# and the session lives in an httpOnly cookie the browser cannot read.

# Production API host. Baked into the built bundle so the site hits the real API.
VITE_API_URL=https://api.hr.aicareeradvisor.io/api

# Override the dev proxy target if the API does not run on port 3000.
# VITE_API_PROXY=http://localhost:4000
