# The client holds no credentials: sign-in runs entirely on the Express server
# and the session lives in an httpOnly cookie the browser cannot read.

# Optional. In development Vite proxies /api to the Express server, so leave this
# unset. Set it when the API lives on another host in production.
# VITE_API_URL=https://your-api.example.com/api

# Override the dev proxy target if the API does not run on port 3000.
# VITE_API_PROXY=http://localhost:3000
